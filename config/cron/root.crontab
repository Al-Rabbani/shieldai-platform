# GDS OS root crontab - THE source of truth. deploy.sh installs this file, so a job added by hand on the host is
# lost at the next deploy: edit here instead. Every entry either loads /opt/.env itself (cron starts without the
# service environment) or runs as postgres, because 70 FORCE-RLS tables return zero rows unbound.


*/5 * * * * /opt/gds-os/apps/api/venv/bin/python3.11 /opt/gds-os/apps/api/check_alerts.py >> /var/log/gds-alerts.log 2>&1

*/30 * * * * flock -n /opt/gds-os/.mission_scheduler.lock /opt/gds-os/apps/api/venv/bin/python3.11 /opt/gds-os/apps/api/run_autonomous_missions.py >> /var/log/gds-autonomous.log 2>&1
0 */6 * * * cd /opt/gds-os/apps/api && set -a && . /opt/.env && set +a && PYTHONPATH=/opt/gds-os/apps/api ./venv/bin/python run_deterministic_scan.py >> /var/log/gds-deterministic-scan.log 2>&1
30 2 * * * /usr/local/bin/gds-backup.sh >> /var/log/gds-backup.log 2>&1
15 3 * * * /usr/local/bin/gds-wal-prune.sh
45 4 * * 0 /usr/local/bin/gds-restore-drill.sh >> /var/log/gds-restore-drill.log 2>&1
15 5 * * 0 /usr/local/bin/gds-pitr-rehearsal.sh >> /var/log/gds-pitr.log 2>&1
*/5 * * * * /usr/local/bin/gds-service-watch.sh
# The acknowledgement ladder. Without a schedule a notification that requires acknowledgement is delivered
# once and then never re-raised, which is a log entry with an email attached. Runs as postgres because
# notifications is FORCE RLS and an unbound read would page nobody.
*/10 * * * * cd /opt/gds-os && sudo -u postgres /opt/gds-os/apps/api/venv/bin/python /usr/local/bin/gds-page.py >> /var/log/gds-pager.log 2>&1
*/30 * * * * /usr/local/bin/gds-backup-watch.sh >> /var/log/gds-backup-watch.log 2>&1
0 */12 * * * cd /opt/gds-os/apps/api && set -a && . /opt/.env && set +a && PYTHONPATH=/opt/gds-os/apps/api ./venv/bin/python enrich_findings.py >> /var/log/gds-enrich.log 2>&1
20 */12 * * * cd /opt/gds-os/apps/api && set -a && . /opt/.env && set +a && PYTHONPATH=/opt/gds-os/apps/api ./venv/bin/python enrich_findings.py --cvss-backfill --limit 400 >> /var/log/gds-enrich.log 2>&1
45 3 * * * cd /opt/gds-os/apps/api && set -a && . /opt/.env && set +a && PYTHONPATH=/opt/gds-os/apps/api ./venv/bin/python /opt/gds-os/scripts/ops/qdrant_prune.py --apply >> /var/log/gds-qdrant-prune.log 2>&1
15 4 * * * cd /opt/gds-os/apps/api && set -a && . /opt/.env && set +a && PYTHONPATH=/opt/gds-os/apps/api ./venv/bin/python reconcile_findings.py --apply >> /var/log/gds-reconcile.log 2>&1
50 * * * * cd /opt/gds-os/apps/api && PYTHONPATH=. /opt/gds-os/apps/api/venv/bin/python3.11 reap_stale_missions.py >> /var/log/gds-reaper.log 2>&1
*/5 * * * * /opt/gds-os/scripts/ops/gds-container-watch.sh >/dev/null 2>&1
15 3 * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && ./apps/api/venv/bin/python scripts/ops/assess_compliance.py >> /var/log/gds-compliance.log 2>&1
0 5 * * 5 /usr/local/bin/gds-os-update.sh apply >> /var/log/gds-os-update.log 2>&1
30 4 * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && ./apps/api/venv/bin/python scripts/ops/gds-container-cve-watch.py >> /var/log/gds-container-cve.log 2>&1
# The dependency watch ran from a live crontab edit only, so the next deploy removed it. It lives here now.
40 4 * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && PYTHONPATH=/opt/gds-os/apps/api ./apps/api/venv/bin/python scripts/ops/osv_check.py >> /var/log/gds-osv-check.log 2>&1
# Approvals expire on their own. Nothing expired them, so a request from a path that no longer exists kept
# looking like a decision the platform was waiting for. Expiring is neither approving nor rejecting.
15 * * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && PYTHONPATH=apps/api ./apps/api/venv/bin/python3.11 scripts/ops/expire_stale_approvals.py >> /var/log/gds-approval-expiry.log 2>&1

# Liveness: an agent that cannot be observed alive cannot be operated. Measured 25 Nov 2026: agent_heartbeats held
# ONE row, for blue_team, dated 18 Nov, so /agents/fleet/status read 'unknown' for 22 of 23 roles. The worker derives
# each role's health from whether its declared tools resolve and their binaries exist, then signs and records it.
# FRESH_WITHIN_SECONDS is 180, so a 2-minute cadence keeps every role inside the fresh window.
*/2 * * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && PYTHONPATH=apps/api ./apps/api/venv/bin/python3.11 scripts/ops/agent_heartbeat.py >> /var/log/gds-heartbeat.log 2>&1

# Every running image is archived to /opt/backups/images with a digest tag, because a registry is not
# guaranteed to still serve it: minio/minio:latest answers "object not found" on Docker Hub and quay.io
# refuses anonymous queries (401), measured 25 Nov 2026. Weekly, so a pruned image or a lost archive heals.
17 3 * * 0 /opt/gds-os/scripts/ops/image_archive.sh >> /var/log/gds-image-archive.log 2>&1

# Close missions that were opened and never finished (measured: 73 abandoned on 25 Nov 2026)
*/30 * * * * cd /opt/gds-os && PYTHONPATH=/opt/gds-os/apps/api /opt/gds-os/apps/api/venv/bin/python -c "import asyncio;from gds_api.reasoning.mission_reaper import reap_stale_missions;print(asyncio.run(reap_stale_missions()))" >> /var/log/gds/mission-reaper.log 2>&1

# A service level that is breached must be said out loud, not only visible to whoever opens /slo. The checker calls
# slo_api.build_report (the same function the route serves) and hands any breach to gds-raise-alert.py, so delivery,
# dedupe and the 5/15/60 escalation ladder are the existing ones. Measured 25 Nov 2026: two objectives were breached
# and nothing in the platform read them.
*/30 * * * * cd /opt/gds-os && /opt/gds-os/apps/api/venv/bin/python scripts/ops/slo_check.py >> /var/log/gds/slo-check.log 2>&1

# An approval waiting for a human must be visible to the human while the decision is still possible. Measured 25 Nov
# 2026: four critical scheduled exposure scans expired undecided, and the only notification about any of them was sent
# at 24 hours, to the requester, after the action had already failed. Reminders at 12h and 20h of the same 24h window
# the expiry job uses, to every active user whose role holds approvals:decide. Offset from the expiry job at :15 so the
# two never race on the same row.
5,20,35,50 * * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && PYTHONPATH=apps/api ./apps/api/venv/bin/python scripts/ops/approval_reminders.py >> /var/log/gds-approval-reminders.log 2>&1

# A capability decision is claimed before its tool runs and resolved after it returns, so a process that dies in
# between leaves the claim standing. Measured 26 Nov 2026: nine decisions sat in execution_status='executing', the
# oldest for 247 hours, and the ledger reported work in progress that had stopped ten days earlier. Sixty minutes is
# the threshold because no governed tool here runs longer than the scanners, which the gateway already caps.
*/30 * * * * cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && PYTHONPATH=apps/api ./apps/api/venv/bin/python scripts/ops/reap_stale_executions.py >> /var/log/gds/stale-executions.log 2>&1

# Coverage is measured weekly, not on every deploy: the suite takes 104 seconds and an incident fix must not wait for it.
# The floor in config/coverage-baseline.json may only be raised, so this catches a quarter of untested code arriving
# while every test still passes. MEASURED 26 Nov 2026, first ever: 1,550 tests, 38.18% of 28,432 statements.
10 5 * * 1 cd /opt/gds-os && set -a && . /opt/.env 2>/dev/null && set +a && PYTHONPATH=apps/api ./apps/api/venv/bin/python scripts/ops/coverage_gate.py --run --raise-alert >> /var/log/gds/coverage.log 2>&1

# Nightly estate sweep: runs every installed scanner against the active AuthorizedTargets and records what each
# one finds. Added 26 Nov 2026 after measuring that nine wired scanners ran only when a mission happened to call
# one, so three had last produced a finding on 1 August. One scanner per row in scan_runs, so a silent scanner is
# visible instead of looking like a quiet estate.
30 1 * * * cd /opt/gds-os/apps/api && set -a && . /opt/.env && set +a && PYTHONPATH=/opt/gds-os/apps/api ./venv/bin/python run_estate_sweep.py >> /var/log/gds-estate-sweep.log 2>&1
